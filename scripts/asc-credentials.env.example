# App Store Connect API credentials for hands-off TestFlight upload from release.sh.
#
# One-time setup:
#   1. App Store Connect -> Users and Access -> Integrations -> App Store Connect API
#      -> generate a key with the "App Manager" (or Admin) role.
#   2. Copy the Key ID and Issuer ID below.
#   3. Download the AuthKey_<KEYID>.p8 (you can only download it once) and place it at
#      ~/.appstoreconnect/private_keys/AuthKey_<KEYID>.p8  (altool auto-discovers it there,
#      so ASC_P8_PATH can be left unset), or set ASC_P8_PATH to wherever you keep it.
#   4. Copy this file to scripts/asc-credentials.env and fill in the values.
#
# scripts/asc-credentials.env is gitignored. NEVER commit the .p8 or the real IDs.

ASC_KEY_ID=XXXXXXXXXX
ASC_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Optional — only if the .p8 is NOT in ~/.appstoreconnect/private_keys/:
# ASC_P8_PATH=/absolute/path/to/AuthKey_XXXXXXXXXX.p8
