{
  "name": "alvernia-reader",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "preios": "node scripts/check-book-consistency.mjs && node scripts/bump-build.mjs",
    "ios": "expo run:ios",
    "preios:mpad": "node scripts/check-book-consistency.mjs && node scripts/bump-build.mjs",
    "ios:mpad": "npx react-native run-ios --udid 2A43D1DE-7C10-540A-A1A3-43D96532C69C",
    "ios:local": "bash ./scripts/start-ios-simulator-local.sh",
    "android": "expo run:android",
    "build:web": "node ./web/build.mjs",
    "deploy:web": "node ./web/build.mjs && npx wrangler pages deploy web/dist --project-name alvernia-reader",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:e2e": "node --test ./e2e/*.test.mjs",
    "postinstall": "node scripts/patch-rn-webview.js && node scripts/patch-hermes-thread.js"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "^54.0.33",
    "expo-asset": "^12.0.12",
    "expo-file-system": "~19.0.21",
    "expo-haptics": "~15.0.8",
    "expo-keep-awake": "~15.0.8",
    "expo-secure-store": "^55.0.13",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-webview": "13.15.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "babel-preset-expo": "^54.0.10",
    "typescript": "^5.4.0"
  }
}
