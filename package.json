    "react-native-webview": "^13.15.0",
    "tonal": "^6.4.3"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "babel-preset-expo": "^54.0.10",
    "typescript": "^5.4.0"
  }
