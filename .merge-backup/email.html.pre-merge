<!DOCTYPE html>
<html>
<body>
  <h2>Test Worker</h2>
  <button onclick="testWorker()">Test Worker</button>
  <pre id="result"></pre>
  
  <script>
    async function testWorker() {
      const resultDiv = document.getElementById('result');
      resultDiv.textContent = 'Sending...';
      
      try {
        const response = await fetch('https://send-email.cb01b2826b7b8ea196b760742b4bb2ee.workers.dev', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            to: 'your-email@example.com',
            subject: 'Test Email',
            htmlContent: '<h1>Test Email</h1><p>This is a test from SendGrid + Cloudflare Workers</p>'
          }),
        });
        
        const result = await response.text();
        resultDiv.textContent = 'Response: ' + result;
      } catch (error) {
        resultDiv.textContent = 'Error: ' + error.message;
      }
    }
  </script>
</body>
</html>
